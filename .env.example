# My Closet — variables de entorno
# Copia este archivo a .env.local y completa lo que necesites.
# La aplicación funciona 100% en local SIN ningún valor configurado.

# Proveedores. Los valores por defecto son locales y nunca conectan terceros.
DATABASE_PROVIDER=sqlite
IMAGE_PROVIDER=local
GOOGLE_AUTH_ENABLED=false

# SQLite local usa ./data/my-closet.db. DATABASE_URL solo se requiere al
# implementar y activar el adaptador PostgreSQL futuro.
DATABASE_URL=

# Secreto para firmar sesiones (obligatorio en producción; generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET=

# URL pública de la app (producción, p.ej. https://my-closet.vercel.app)
NEXT_PUBLIC_APP_URL=

# Cloudinary futuro. Las tres credenciales deben configurarse juntas y solo se
# usan cuando IMAGE_PROVIDER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Sign-In futuro. Las credenciales no muestran el botón por sí solas;
# también requiere GOOGLE_AUTH_ENABLED=true y el flujo OAuth implementado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
