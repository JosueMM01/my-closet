# My Closet — variables de entorno
# Copia este archivo a .env.local y completa lo que necesites.
# Sin valores configurados no se conecta a ningún servicio externo.

# Proveedores. Los valores por defecto son locales y nunca conectan terceros.
DATABASE_PROVIDER=sqlite
IMAGE_PROVIDER=local
GOOGLE_AUTH_ENABLED=false
EMAIL_PROVIDER=disabled

# SQLite local usa ./data/my-closet.db. PostgreSQL requiere la URL pooled para
# runtime y la URL directa para migraciones.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Secreto para firmar sesiones (obligatorio en producción; generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET=

# Registro público deshabilitado por defecto. Actívalo solo de forma explícita
# para pruebas que necesiten acceso directo a /register.
PUBLIC_REGISTRATION_ENABLED=false

# Bootstrap local inicial. Configura ambos valores juntos; solo se usan si la
# tabla users está vacía y la contraseña se almacena únicamente como scrypt.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# URL pública de la app (producción, p.ej. https://my-closet.vercel.app)
NEXT_PUBLIC_APP_URL=

# Cloudinary futuro. Las tres credenciales deben configurarse juntas y solo se
# usan cuando IMAGE_PROVIDER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Sign-In. Solo se activa con GOOGLE_AUTH_ENABLED=true, ambas
# credenciales y NEXT_PUBLIC_APP_URL configurados.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo de invitaciones y recuperación. Configura los seis valores como grupo; las
# credenciales por sí solas no activan SMTP. Gmail usa smtp.gmail.com, puerto
# 465, SMTP_SECURE=true y una App Password como SMTP_PASSWORD.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
